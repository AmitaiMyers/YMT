# Copy to .env (never commit .env).
# Port the server listens on.
PORT=3001
# Where the SQLite database file lives. All business data is stored ONLY in this file.
DATA_DIR=./data
# Set to "production" when served over HTTPS (enables Secure cookies).
NODE_ENV=development
# Human-readable description of where this server is hosted (shown on the Data & Privacy page).
HOSTING_LOCATION=Local development machine
# How many reverse proxies sit in front of the app (e.g. 1 on Render/Fly/Railway or behind nginx).
# Keep "loopback" when running directly on a machine. Wrong values break per-user login rate limiting.
TRUST_PROXY=loopback

# Google Calendar (optional – set all four or none). See README → "Google Calendar".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PUBLIC_URL=https://your-app.onrender.com
# TOKEN_ENCRYPTION_KEY=   # 32+ random characters; changing it disconnects everyone
